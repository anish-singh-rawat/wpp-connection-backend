NODE_ENV=production
PORT=8086

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<pass>@cluster.mongodb.net/wpp-system?retryWrites=true&w=majority

# ─── JWT Authentication ────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -hex 64
JWT_SECRET=replace-with-a-strong-random-64-char-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-64-char-secret
JWT_REFRESH_EXPIRES_IN=30d

# ─── Legacy API Key (backward compat — optional) ─────────────────────────────
# API_KEY=your-old-static-api-key

# ─── WhatsApp Session ─────────────────────────────────────────────────────────
WA_SESSION=default-session
SESSION_PATH=/home/ubuntu/whatsapp-api/sessions

# ─── Messaging Tuning (optional) ──────────────────────────────────────────────
MSG_MIN_DELAY=5000
MSG_MAX_DELAY=10000
MSG_MAX_RETRIES=2
MSG_RETRY_DELAY=3000

# ─── Rate Limiting (optional) ─────────────────────────────────────────────────
# Global requests/minute cap (express-rate-limit)
RATE_LIMIT_MAX=100
# Default per-customer API token rate limit (requests/minute)
CUSTOMER_RATE_LIMIT=100
